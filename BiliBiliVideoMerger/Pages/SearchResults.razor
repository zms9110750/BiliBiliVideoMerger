@using BiliBiliVideoMerger.Model
@using Humanizer
@using System.Reflection
@using System.ComponentModel.DataAnnotations


<MDataTable Search="@_search"
            Headers="Headers"
            Items="ItemsDic.Values"
            Dense
            ResizeMode="DataTableResizeMode.Independent"
            ItemKey="@(t => t.Bvid)"
            ShowExpand
            HideDefaultFooter="false"
            Class="elevation-1"
            ItemsPerPage="10"
            Loading="loading">
    <TopContent>
        <MTextField @bind-Value="_search" Label="搜索"></MTextField>
    </TopContent>
    <HeaderColContent Context="header">
        @if (header.Text == "处理")
        {
            int selectedCount = ItemsDic.Values.Count(item => item.AllSelected);
            int totalCount = ItemsDic.Count;

            bool allSelected = selectedCount == totalCount && totalCount != 0;
            bool indeterminate = selectedCount > 0 && selectedCount < totalCount;

            <MSimpleCheckbox 
                            Disabled="Running"
                            Value="allSelected"
                             Indeterminate="indeterminate"
                             ValueChanged="@(b=>{ 
                             foreach (var item in ItemsDic.Values)
                             {
                                 item.AllSelected = b;
                             }
                         })" />
         }
         else
        {
            @header.Text
        }
    </HeaderColContent>
    <ItemColContent>
        @switch (context.Header.Text)
        {
            case "up" :
            case "bv":
             <MTextField Value="@context.Value"
                              Dense 
                              Filled
                              HideDetails="@("auto")"
                              Readonly
                              Style="font-size: 14px">
                              </MTextField>  
                break;
            case "大小":
                @ByteSize.FromBytes(Convert.ToInt64(context.Value)).Humanize()
                break;
            case "标题":
            <MTextField @bind-Value="context.Item.Title" 
                              Dense 
                              HideDetails="@("auto")"
                              Style="font-size: 14px">
                              </MTextField>  
                break;
            case "时长":
                var ts = (TimeSpan)context.Value!;
                var totalMinutes = (int)ts.TotalMinutes;  // 总分钟数
                var seconds = ts.Seconds;
                @($"{totalMinutes:D2}:{seconds:D2}")
                break;
            case "下载时间":
                @(((DateTime)context.Value!).ToString("yyyy/MM/dd-HH:mm"))
                break;
            case "处理":
                <MSimpleCheckbox @bind-Value="context.Item.AllSelected" 
                Disabled="Running" 
                                 Indeterminate="@(context.Item.Indeterminate)" />
                break;
            default:
                @context.Value
                break;
        }
    </ItemColContent>
    <ExpandedItemContent>
        <td colspan="@int.MaxValue">
            <MDataTable Headers="ChindelHeaders"
                        Items="@context.Item.Pages"
                        Dense
                        ResizeMode="DataTableResizeMode.Independent"
                        ItemKey="@(t => t.EntryPath)"
                        HideDefaultFooter
                        ItemsPerPage="-1">
                <ItemColContent Context="item">
                    @switch (item.Header.Text)
                    {
                        case "大小":
                            @ByteSize.FromBytes(Convert.ToInt64(item.Value)).Humanize()
                            break;
                             case "标题":
                             <MTextField @bind-Value="item.Item.PageData.Part" 
                              Dense 
                              HideDetails="@("auto")"
                              Style="font-size: 14px">
                              </MTextField> 
                             break;
                        case "时长":
                            var ts = (TimeSpan)item.Value!;
                            var totalMinutes = (int)ts.TotalMinutes;  // 总分钟数
                            var seconds = ts.Seconds;
                            @($"{totalMinutes:D2}:{seconds:D2}")
                            break;
                        case "下载时间":
                            @(((DateTime)item.Value!).ToString("yyyy/MM/dd-HH:mm"))
                            break;
                        case "处理":
                            <MSimpleCheckbox  Disabled="Running" Value="context.Item.Selected.Contains((BilibiliVideoMetadata)item.Item)"
                                             ValueChanged="b=>context.Item.SelectedChange((BilibiliVideoMetadata)item.Item)" />
                            break;
                            case "文件路径": 
                            <MTextField Value="@item.Value"
                              Dense 
                              Filled
                              HideDetails="@("auto")"
                              Readonly
                              Style="font-size: 14px">
                              </MTextField>  
                               break;
                        default:
                            @item.Value
                            break;
                    }
                </ItemColContent>
            </MDataTable>
        </td>
    </ExpandedItemContent>
</MDataTable>

@code {
    [Parameter]
    public bool Running { get; set; }
    string? _search;
    bool loading = true;
    List<string> hello = [];
    List<DataTableHeader<BiliBiliModel>> Headers { get; } = [];
    List<DataTableHeader<BilibiliVideoMetadata>> ChindelHeaders { get; } =
    [
        new ("分p",nameof(BilibiliVideoMetadata.PageData.Page)){ValueExpression= t=>t.PageData.Page },
        new( "标题",nameof(BilibiliVideoMetadata.PageData.Part)){ValueExpression= t=>t.PageData.Part },
        new ("时长", nameof(BilibiliVideoMetadata.TotalTime)),
        new ("大小", nameof(BilibiliVideoMetadata.TotalBytes)),
        new ("文件路径",  nameof(BilibiliVideoMetadata.EntryPath)),
    ]; 
    [Parameter]
    public IAsyncEnumerable<BilibiliVideoMetadata>? ItemsTask { get; set; }
    Dictionary<string, BiliBiliModel> ItemsDic { get; } = [];
    protected override void OnInitialized()
    {
        base.OnInitialized();
        List<DisplayAttribute> list = [];
        foreach (var item in typeof(BiliBiliModel).GetProperties())
        {
            var display = item.GetCustomAttribute<DisplayAttribute>();
            if (display == null)
            {
                continue;
            }
            display.ShortName = item.Name;
            list.Add(display);
        }
        Headers.AddRange(list.OrderBy(a => a.Order).Select(a => new DataTableHeader<BiliBiliModel>(a.Name, a.ShortName)));
        Headers.Insert(0, new("处理", nameof(BiliBiliModel.AllSelected)) { Width=20 });
        ChindelHeaders.Insert(0, new("处理", nameof(BiliBiliModel.Selected)) {  Width=20,ValueExpression = t => ItemsDic[t.Bvid].Selected.Contains(t) });

    }
    protected override async Task OnInitializedAsync()
    {
        ArgumentNullException.ThrowIfNull(ItemsTask);
        await base.OnInitializedAsync();
        await foreach (var item in ItemsTask)
        {
            if (ItemsDic.TryGetValue(item.Bvid, out var bilibilis))
            {
                bilibilis.Add(item);
            }
            else
            {
                ItemsDic.Add(item.Bvid, new BiliBiliModel(item));
            }
        }
        loading = false;
        await    SelectedItemsChanged.InvokeAsync(ItemsDic.Values); 
        
    }
    [Parameter]
    public EventCallback<IEnumerable<BiliBiliModel>> SelectedItemsChanged { get; set; } 
}